<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- location -->
    <record id="view_location_qus_tree" model="ir.ui.view">
        <field name="name">location.qus.tree</field>
        <field name="model">location.qus</field>
        <field name="arch" type="xml">
            <list string="Location" editable="bottom">
                <field name="name"/>
                <field name="score"/>
            </list>
        </field>
    </record>

    <record id="view_location_qus_form" model="ir.ui.view">
        <field name="name">location.qus.form</field>
        <field name="model">location.qus</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="score"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_location_qus" model="ir.actions.act_window">
        <field name="name">Location</field>
        <field name="res_model">location.qus</field>
        <field name="view_mode">list,form</field>
    </record>

