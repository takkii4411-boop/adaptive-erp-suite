    <record id="view_all_qus_form" model="ir.ui.view">
        <field name="name">question.base.form</field>
        <field name="model">question.base</field>
        <field name="arch" type="xml">
            <form string="Project Criteria">
                <header>
                    <button type="object" name="action_open_view" string="New" class="btn-primary"/>
