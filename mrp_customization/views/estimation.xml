<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estimation_mrp_order_view_form" model="ir.ui.view">
        <field name="name">sale.estimation.view.form.mrp.order.inherit</field>
        <field name="model">sale.estimation</field>
        <field name="inherit_id" ref="sales_customization.view_sale_estimation_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Create Manufacturing Order" name="action_create_manufacturing_order" type="object" class="btn btn-primary" data-hotkey="g"
                invisible="status != 'done' or mrp_ids"/>
                <button string="Create Manufacturing Order" name="action_create_manufacturing_order" type="object" class="btn btn-secondary" data-hotkey="g"
                invisible="status != 'done' or not mrp_ids"/>
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="action_open_mrp_order"
                    type="object"
                    string="Sale Orders"
                    class="oe_stat_button"
                    icon="fa-wrench"
                    invisible="not mrp_ids">
                    <field name="mrp_order_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>