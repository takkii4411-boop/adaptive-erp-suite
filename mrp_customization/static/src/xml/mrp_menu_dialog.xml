<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_customization.MrpDisplayMenuDialog" t-inherit="mrp_workorder.MrpDisplayMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[@name='block']" position="before">
            <div class="col-6 p-1">
                <button class="d-flex flex-column gap-1 btn btn-secondary fs-3 w-100 h-100 py-3"
                    t-on-click="previewNR" name="previewNR">
                    <i class="fa fa-eye"/>Preview Nesting Report
                </button>
            </div>
        </xpath>
    </t>
</templates>