<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_documents_document_list_inherit" model="ir.ui.view">
        <field name="name">documents.document.list.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list_main"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">name</attribute>
            </xpath>
            <xpath expr="//field[@name='folder_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='write_date']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='file_size']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <button name="action_preview_drawing_nos"
                    type="object"
                    icon="fa-eye"
                    title="Preview"
                    class="btn btn-link btn-sm lh-1 p-0"
                />
            </xpath>
        </field>
    </record>

</odoo>
