<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estimation_project_task_view_form" model="ir.ui.view">
        <field name="name">sale.estimation.view.form.lead.inherit</field>
        <field name="model">sale.estimation</field>
        <field name="inherit_id" ref="sales_customization.view_sale_estimation_type_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_project"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-puzzle-piece"
                    invisible="not (project_count or project_task_count)"
                >
                    <div class="o_stat_info">
                        <div class="o_row">
                            <span class="o_stat_value order-first">
                                <field name="project_count"/>
                            </span>
                            <span class="o_stat_text"> Projects</span>
                        </div>
                        <div class="o_row">
                            <span class="o_stat_value order-first">
                                <field name="project_task_count"/>
                            </span>
                            <span class="o_stat_text"> Tasks</span>
                        </div>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>