<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_estimation_joinery_name_list" model="ir.ui.view">
        <field name="name">sale.estimation.level.tree</field>
        <field name="model">joinery.name</field>
        <field name="arch" type="xml">
            <list string="Joinery Name" editable="bottom">
                <field name="name"/>
                <field name="sequence"/>
            </list>
        </field>
    </record>

    <record id="view_sale_estimation_joinery_name_form" model="ir.ui.view">
        <field name="name">sale.estimation.level.form</field>
        <field name="model">joinery.name</field>
        <field name="arch" type="xml">
            <form string="Joinery Name">
                <sheet>
                    <group>
                        <field name="sequence"/>
                    </group>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Residential, Commercial..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_estimation_joinery_name" model="ir.actions.act_window">
        <field name="name">Joinery Name</field>
        <field name="res_model">joinery.name</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Joinery.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_estimation_joinery_name"
              name="Joinery Name"
              parent="sales_customization.menu_sale_estimation_config"
              action="action_sale_estimation_joinery_name"
              sequence="6"/>

</odoo>