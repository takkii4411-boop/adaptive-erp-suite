<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_estimation_level_tree" model="ir.ui.view">
        <field name="name">sale.estimation.level.tree</field>
        <field name="model">sale.estimation.level</field>
        <field name="arch" type="xml">
            <list string="Levels" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_sale_estimation_level_form" model="ir.ui.view">
        <field name="name">sale.estimation.level.form</field>
        <field name="model">sale.estimation.level</field>
        <field name="arch" type="xml">
            <form string="Levels">
                <sheet>
                    <group>
                        <field name="sequence"/>
                    </group>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Residential, Commercial..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_estimation_level" model="ir.actions.act_window">
        <field name="name">Levels</field>
        <field name="res_model">sale.estimation.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new project type.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_estimation_level"
              name="Levels"
              parent="sales_customization.menu_sale_estimation_config"
              action="action_sale_estimation_level"
              sequence="2"/>

</odoo>