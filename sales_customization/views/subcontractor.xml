<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_estimation_subcontractor_tree" model="ir.ui.view">
        <field name="name">sale.estimation.subcontractor.tree</field>
        <field name="model">sale.estimation.subcontractor</field>
        <field name="arch" type="xml">
            <list string="Subcontractors" editable="bottom">
                <field name="product_id"/>
                <field name="subcontractor_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_sale_estimation_subcontractor_form" model="ir.ui.view">
        <field name="name">sale.estimation.subcontractor.form</field>
        <field name="model">sale.estimation.subcontractor</field>
        <field name="arch" type="xml">
            <form string="Subcontractors">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Residential, Commercial..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="subcontractor_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_estimation_subcontractor" model="ir.actions.act_window">
        <field name="name">Subcontractors</field>
        <field name="res_model">sale.estimation.subcontractor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new project type.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_estimation_subcontractor"
              name="Subcontractors"
              parent="sales_customization.menu_sale_estimation_config"
              action="action_sale_estimation_subcontractor"
              sequence="4"/>

</odoo>