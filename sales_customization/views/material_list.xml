<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_material_list_form" model="ir.ui.view">
        <field name="name">material.list.form</field>
        <field name="model">material.list</field>
        <field name="arch" type="xml">
            <form string="Material List" js_class="wizard_form" create="false">
                <header>
                     <button name="action_go_back"
                             string="Back"
                             type="object"
                             class="btn btn-secondary oe_highlight mb-2"
                             invisible="context.get('from_product_catalog')"/>
                 </header>
                <sheet>
                    <group style="font-size:12px;">
                        <notebook>
                            <page string="Materials">
                                <field name="order_line">
                                    <list editable="bottom" limit="100" class="o_scrollable_list order_line_list" default_order='sequence'>
                                        <field name="sequence"/>
                                        <field name="product_id" required="1" domain="product_domain" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="product_uom"/>
                                        <field name="rate"/>
                                        <field name="product_uom_qty" column_invisible="1"/>
                                        <field name="price_unit" column_invisible="1"/>
                                        <field name="price_subtotal" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_material_record" string="Save" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel" confirm="Are you sure to discard the changes?"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>