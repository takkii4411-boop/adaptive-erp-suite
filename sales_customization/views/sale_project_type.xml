<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_project_type_tree" model="ir.ui.view">
        <field name="name">sale.project.type.tree</field>
        <field name="model">sale.project.type</field>
        <field name="arch" type="xml">
            <list string="Project Types" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_sale_project_type_form" model="ir.ui.view">
        <field name="name">sale.project.type.form</field>
        <field name="model">sale.project.type</field>
        <field name="arch" type="xml">
            <form string="Project Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Residential, Commercial..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_project_type" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">sale.project.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new project type.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_project_type"
              name="Project Types"
              parent="sales_customization.menu_sale_estimation_config"
              action="action_sale_project_type"
              sequence="1"/>

</odoo>