    <record id="view_sale_estimation_line_description_wizard_form" model="ir.ui.view">
        <field name="name">sale.estimation.line.description.wizard.form</field>
        <field name="model">sale.estimation.line.description.wizard</field>
        <field name="arch" type="xml">
            <form string="Description">
                <sheet>
                    <field name="description" nolabel="1" widget="html"/>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="action_save_description" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_estimation_line_internal_notes_wizard_form" model="ir.ui.view">
        <field name="name">sale.estimation.line.internal.notes.wizard.form</field>
        <field name="model">sale.estimation.line.internal.notes.wizard</field>
        <field name="arch" type="xml">
            <form string="Internal Notes">
                <sheet>
                    <field name="internal_notes" nolabel="1"/>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="action_save_internal_notes" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_estimation_line_custom_exclusion_wizard_form" model="ir.ui.view">
        <field name="name">sale.estimation.line.custom.exclusion.wizard.form</field>
        <field name="model">sale.estimation.line.custom.exclusion.wizard</field>
        <field name="arch" type="xml">
            <form string="Custom Exclusion">
                <sheet>
                    <field name="custom_exclusion" nolabel="1"/>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="action_save_custom_exclusion" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

