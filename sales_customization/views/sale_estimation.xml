                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_drawing_no" placeholder="Arch Drawing No" nolabel="1"/>
                            </div>
                            <!-- Filter for internal_notes -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_internal_notes" placeholder="Internal Notes" nolabel="1"/>
                            </div>
                            <!-- Filter for custom_exclusion -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_custom_exclusion" placeholder="Custom Exclusion" nolabel="1"/>
                            </div>
                            <!-- Spacers for qty, price_unit, price_total -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;"></div>
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;"></div>
                            <!-- Action buttons -->
                            <div style="flex: 1; display: flex; justify-content: flex-end; gap: 8px; align-items: center;">
                                <button type="object" class="btn btn-link btn-sm" name="action_clear_all">Clear</button>
                                <button type="object" class="btn btn-link btn-sm" name="action_add_lines">Copy</button>
                            </div>
                        </div>

                        <field name="estimation_line_ids" widget="estimation_line_x2many">
                            <list editable="bottom" limit="1000">
                                <field name="is_select" nolabel="1" widget="highlight_row_boolean"/>
                                <button type="object" name="action_open_bom"
                                        class="btn btn-link text-action oi o_external_button px-1 oi-arrow-right"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="is_not_active"/>
                                <field name="level_id"/>
                                <field name="joinery_type" optional="hide"/>
                                <field name="product_id" domain="product_domain" context="{'default_joinery_type': joinery_type}"/>
                                <field name="joinery_name_id"/>
                                <field name="cl_no" column_invisible="1"/>
                                <field name="description" readonly="1"/>
                                <button name="action_open_description_popup"
                                type="object"
                                string=""
                                icon="fa-file-text-o"
                                context="{'click_from_list': True}"/>
                                <field name="room"/>
                                <field name="stage"/>
                                <field name="drawing_number"/>
                                <field name="internal_notes" class="o_details_hidden"/>
                                <button name="action_open_internal_notes_popup"
                                        type="object"
                                        string=""
                                        icon="fa-file-text-o"
                                        context="{'click_from_list': True}"/>
                                <field name="custom_exclusion" class="o_details_hidden"/>
                                <button name="action_open_custom_exclusion_popup"
                                        type="object"
                                        string=""
                                        icon="fa-file-text-o"
                                        context="{'click_from_list': True}"/>
                                <field name="qty"/>
                                <field name="total_cost"/>
                                <field name="price_unit" widget='monetary'
                                       options="{'currency_field': 'currency_id'}"/>/>
                                <field name="tax_ids" widget="many2many_tags"/>
                                <field name="total_margin"/>
                                <field name="price_subtotal" widget='monetary' string="Total"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="price_total" widget='monetary' string="Tax Incl." optional="hide"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="is_copied_line" column_invisible="1" nolabel="1"/>
                                <field name="is_existing_line" column_invisible="1" nolabel="1"/>
                                <field name="parent_id" column_invisible="1" nolabel="1"/>
                            </list>
                        </field>
                        <group class="oe_subtotal_footer d-flex order-0 order-lg-1 flex-column gap-0 estimation_total_footer"
