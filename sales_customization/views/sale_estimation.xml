<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_estimation_type_tree" model="ir.ui.view">
        <field name="name">sale.estimation.tree</field>
        <field name="model">sale.estimation</field>
        <field name="arch" type="xml">
            <list string="Estimator" default_order="name asc">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="project_type_id"/>
                <field name="joinery_type"/>
                <field name="amount_cost" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                <field name="amount_margin" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-warning="status == 'sent'"
                       decoration-danger="status == 'cancel'"
                       decoration-success="status == 'done'" />
            </list>
        </field>
    </record>

    <record id="view_sale_estimation_type_form" model="ir.ui.view">
        <field name="name">sale.estimation.form</field>
        <field name="model">sale.estimation</field>
        <field name="arch" type="xml">
            <form string="Estimator" js_class="sale_estimation_form">
                <header>
                    <!-- Send -->
                    <button name="action_estimation_send"
                            type="object"
                            string="Send by Email"
                            class="btn-primary"
                            invisible="status != 'draft'"/>

                    <button name="action_estimation_send"
                            type="object"
                            string="Send by Email"
                            class="btn-secondary"
                            invisible="status not in ['done', 'sent']"/>

                    <!-- Confirm -->
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-secondary"
                            invisible="status not in ['draft', 'sent']"/>

                    <!-- Cancel -->
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="status == 'cancel'"/>

                    <!-- Reset to Draft -->
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="status not in ['cancel']"/>

                    <field name="status" nolabel="1" colspan="2" statusbar_visible="draft,sent,done"
                           widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <!--                <sheet>-->
                <div name="button_box" position="inside">
                    <button class="oe_stat_button" type="object" name="action_view_estimations"
                            icon="fa-usd" invisible="estimations_count == 0">
                        <field string="Estimations" name="estimations_count" widget="statinfo"/>
                    </button>
                </div>
                <group style="justify-content:start;border-bottom:1px solid #E6E6E6;">
                    <div class="col-lg-12" style="text-align:start;">
                        <button type="object"
                            name="toggle_details"
                            string="Show Details"
                            invisible="not display_details"
                            class="btn btn-secondary">
                            <i class="oi oi-fw oi-panel-right fa-flip-horizontal"/>
                        </button>
                        <button type="object"
                            name="toggle_details"
                            string="Hide Details"
                            invisible="display_details"
                            class="btn btn-secondary">
                            <i class="oi oi-fw oi-panel-right fa-flip-horizontal"/>
                        </button>
                        <span style="margin-left:4px;"/>
                        <button name="action_export_selected_xlsx"
                            type="object"
                            string="Export">
                            <i class="fa fa-upload me-1"/>Export
                        </button>
                    </div>

                    <group string="Details" invisible="display_details" style="width:27%;font-size: 11px;border-right:1px solid #E6E6E6;border-top:1px solid #E6E6E6;padding-right: 0;display: block;">
                        <div class="oe_title" style="max-width:93%!important;">
                            <div class="d-flex align-items-baseline">
                                <h5>
                                    <span>Estimation No.</span>
                                </h5>
                                <h5 style="margin-left:15px;">
                                    <field name="name" placeholder="e.g. Residential, Commercial..." readonly="1"/>
                                </h5>
                            </div>
                            <group>
                                <div id="estimation_left">
                                    <field name="currency_id" invisible="1"/>
                                    <div class="d-flex align-items-baseline">
                                        <label for="project_id"/>
                                        <field name="project_id"/>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <label for="employee_id"/>
                                        <field name="employee_id"/>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <label for="project_type_id"/>
                                        <field name="project_type_id"/>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <label for="joinery_type"/>
                                        <field name="joinery_type"/>
                                    </div>
                                </div>
                            </group>
                            <notebook>
                                <page string="Builders" name="builders">
                                    <field name="builder_ids">
                                        <list editable="bottom">
                                            <field name="partner_id" domain="partner_domain"/>
                                            <field name="status"/>
                                            <field name="is_mail_sent"/>
                                            <field name="winner"/>
                                            <field name="is_client"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="Sub-Contractors" name="sub_contractors">
                                    <field name="subcontractor_ids">
                                        <list editable="bottom">
                                            <field name="partner_id"/>
                                            <field name="status"/>
                                            <field name="winner"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="Internal Review" name="internal_review">
                                    <group name="internal_review_group">
                                        <field name="internal_review" nolabel="1"
                                               placeholder="Internal Review..."/>
                                    </group>
                                </page>
                            </notebook>
                            <group>
                                <notebook>
                                    <page string="Exclusions" name="exclusions">
                                        <group name="exclusions_group">
                                            <field name="exclusions" nolabel="1" placeholder="Standard Exclusions..."/>
                                        </group>
                                        <group name="custom_exclusions_group">
                                            <field name="custom_exclusions" nolabel="1" placeholder="Custom Exclusions..."/>
                                        </group>
                                    </page>
                                    <page string="Project Specific Notes" name="standard_notes">
                                        <group name="standard_notes_group">
                                            <field name="standard_notes" nolabel="1"
                                                   placeholder="Project Specific Notes..."/>
                                        </group>
                                    </page>
                                    <page string="Terms &amp; Conditions" name="terms_condition">
                                        <group name="terms_condition_group">
                                            <field name="terms_condition" nolabel="1"
                                                   placeholder="Terms &amp; Conditions..."/>
                                        </group>
                                    </page>
                                </notebook>
                            </group>
                            <group string="Comments" name="comments_group" style="display: block;">
                                <field name="comments" nolabel="1" placeholder="Comments..."/>
                            </group>
                        </div>
                    </group>
                    <group name="not_display_details" invisible="not display_details" style="width:100%;font-size: 11px;border-top:1px solid #E6E6E6;" string="Joinery Items">
                        <div class="col-lg-12" style="text-align:end;">
                            <button type="object" class="btn btn-link" name="action_materials_open">Materials</button>
                        </div>
                        <div class="estimation_filter_wrapper" style="display: flex; padding-bottom: 8px; border-bottom: 1px solid #dee2e6; margin-bottom: 0; align-items: center;">
                            <!-- Filters label - aligned with checkbox column -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px; font-weight: bold; display: flex; align-items: center; justify-content: center;">
                                Filters:
                                <div class="d-flex select-all-div" style="padding: 4px 0 8px 0; align-items: center;">
                                    <field name="select_all" nolabel="1"/>
                                    <button type="object" invisible="not select_all" name="action_open_bom_all"
                                            class="btn btn-link oi o_external_button px-1 oi-arrow-right"
                                            style="margin-left: 8px;"/>
                                </div>
                            </div>
                            <!-- Button column spacer -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;"></div>
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;"></div>
                            <!-- Filter for level_id -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_level" placeholder="Level" nolabel="1" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </div>
                            <!-- Filter for product_id -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_product_id" placeholder="Joinery No" nolabel="1" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="filter_product_domain"/>
                            </div>
                            <!-- Filter for joinery_name -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_joinery_name" placeholder="Joinery Name" nolabel="1" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="filter_joinery_name_domain"/>
                            </div>
                            <!-- Spacer for cl_no (hidden) - not visible so skip in alignment -->
                            <!-- Filter for description -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_description" placeholder="Description" nolabel="1"/>
                            </div>
