    <record id="view_sale_estimation_search" model="ir.ui.view">
        <field name="name">sale.estimation.search</field>
        <field name="model">sale.estimation</field>
        <field name="arch" type="xml">
            <search string="Estimator">

                <!-- Standard Search Fields -->
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="project_type_id"/>
                <field name="joinery_type"/>
                <field name="status"/>

                <!-- Filters -->
                <filter name="filter_draft" string="Draft" domain="[('status','=','draft')]"/>
                <filter name="filter_sent" string="Sent" domain="[('status','=','sent')]"/>
                <filter name="filter_done" string="Completed" domain="[('status','=','done')]"/>

                <!-- Group by -->
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Project Type" context="{'group_by': 'project_type_id'}"/>
                    <filter name="group_joinery" string="Joinery Type" context="{'group_by': 'joinery_type'}"/>
                    <filter name="group_activity_type" string="Activity Type" context="{'group_by': 'custom_activity_type_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_sale_estimation_type" model="ir.actions.act_window">
        <field name="name">Estimator</field>
        <field name="res_model">sale.estimation</field>
        <field name="view_mode">list,activity,form</field>
        <field name="search_view_id" ref="sales_customization.view_sale_estimation_search"/>
    </record>

    <menuitem id="menu_sale_estimation_type"
              name="Estimator"
              web_icon="sales_customization,static/description/icon.png"/>

    <menuitem id="menu_sale_estimation_type_sub"
              name="Estimations"
              parent="menu_sale_estimation_type"
              action="action_sale_estimation_type" sequence="1"/>

    <menuitem id="menu_sale_estimation_config"
              name="Configuration"
              parent="menu_sale_estimation_type" sequence="99"/>


    <record id="action_sale_estimation" model="ir.actions.server">
        <field name="name">Update</field>
        <field name="model_id" ref="model_sale_estimation"/>
        <field name="binding_model_id" ref="model_sale_estimation"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.action_update()
        </field>
    </record>

