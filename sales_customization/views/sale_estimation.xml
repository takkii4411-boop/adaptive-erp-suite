                            <div class="d-flex align-items-baseline">
                                <label for="amount_untaxed"/>
                                <field name="amount_untaxed" widget='monetary'
                                       options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </div>
                            <div class="d-flex align-items-baseline">
                                <label for="amount_tax"/>
                                <field name="amount_tax" widget='monetary'
                                       options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </div>
                            <div class="d-flex align-items-baseline">
                                <label for="amount_margin"/>
                                <field name="amount_margin" widget='monetary'
                                       options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </div>
                            <div class="d-flex align-items-baseline">
                                <label for="amount_total"/>
                                <field name="amount_total" widget='monetary'
                                       options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </div>
                        </group>
                    </group>
                    <group name="display_details" invisible="display_details" style="width:73%;font-size: 11px;border-top:1px solid #E6E6E6;" string="Joinery Items">
                        <div class="col-lg-12" style="text-align:end;">
                            <button type="object" class="btn btn-link" name="action_materials_open">Materials</button>
                        </div>
                        <div class="estimation_filter_wrapper" style="display: flex; padding-bottom: 8px; border-bottom: 1px solid #dee2e6; margin-bottom: 0; align-items: center;">
                            <!-- Filters label - aligned with checkbox column -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px; font-weight: bold; display: flex; align-items: center; justify-content: center;">
                                Filters:
                                <div class="d-flex select-all-div" style="padding: 4px 0 8px 0; align-items: center;">
                                    <field name="select_all" nolabel="1"/>
                                    <button type="object" invisible="not select_all" name="action_open_bom_all"
                                            class="btn btn-link oi o_external_button px-1 oi-arrow-right"
                                            style="margin-left: 8px;"/>
                                </div>
                            </div>
                            <!-- Button column spacer -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;"></div>
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;"></div>
                            <!-- Filter for level_id -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_level" placeholder="Level" nolabel="1" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </div>
                            <!-- Filter for product_id -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_product_id" placeholder="Joinery No" nolabel="1" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="filter_product_domain"/>
                            </div>
                            <!-- Filter for joinery_name -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_joinery_name" placeholder="Joinery Name" nolabel="1" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="filter_joinery_name_domain"/>
                            </div>
                            <!-- Spacer for cl_no (hidden) - not visible so skip in alignment -->
                            <!-- Filter for description -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
                                <field name="filter_description" placeholder="Description" nolabel="1"/>
                            </div>
                            <!-- Spacer for description button -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;"></div>
                            <!-- Spacer for stage (hidden) - not visible so skip in alignment -->
                            <!-- Filter for room -->
                            <div class="filter-cell" style="flex-shrink: 0; padding: 0 4px;">
