<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.custom</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="shops" string="Shops" invisible="not shop_ids">
                    <field name="shop_ids">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="1"/>
                            <field name="workcenter_id" column_invisible="1"/>
                            <field name="duration" column_invisible="1"/>
                            <field name="product_id" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="rate"/>
                            <field name="quantity"/>
                            <field name="uom"/>
                            <field name="margin"/>
                            <field name="margin_diff" readonly="1"/>
                            <field name="subtotal" widget='monetary' options="{'currency_field': 'currency_id'}" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>