<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_finish_list" model="ir.ui.view">
        <field name="name">product.finish.list</field>
        <field name="model">product.finish</field>
        <field name="arch" type="xml">
            <list string="Product Finish" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    
    <record id="view_product_finish" model="ir.ui.view">
        <field name="name">product.finish.form</field>
        <field name="model">product.finish</field>
        <field name="arch" type="xml">
            <form string="Product Finish">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
        <record id="action_product_finish" model="ir.actions.act_window">
        <field name="name">Product Finish</field>
        <field name="res_model">product.finish</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product finish.
            </p>
        </field>
    </record>

    <menuitem
        action="inventory_customization.action_product_finish" id="menu_product_finish"
        parent="stock.menu_product_in_config_stock" sequence="7"/>
</odoo>