<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_supplierinfo_form_inherit_preferred" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.inherit.preferred</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="is_preferred" widget="boolean_toggle" on_change="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_product_supplierinfo_tree_inherit_preferred" model="ir.ui.view">
        <field name="name">product.supplierinfo.tree.inherit.preferred</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="is_preferred" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>