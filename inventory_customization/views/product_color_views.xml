<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_color_list" model="ir.ui.view">
        <field name="name">product.color.list</field>
        <field name="model">product.color</field>
        <field name="arch" type="xml">
            <list string="Product Color" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="view_product_color_form" model="ir.ui.view">
        <field name="name">product.color.form</field>
        <field name="model">product.color</field>
        <field name="arch" type="xml">
            <form string="Product Color">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_color" model="ir.actions.act_window">
        <field name="name">Product Color</field>
        <field name="res_model">product.color</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product Color.
            </p>
        </field>
    </record>

    <menuitem
        action="inventory_customization.action_product_color" id="menu_product_color"
        parent="stock.menu_product_in_config_stock" sequence="6"/>

</odoo>